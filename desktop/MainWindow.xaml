<Window x:Class="CTRL.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CTRL Desktop Shell" Height="380" Width="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Closing="OnClosing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Server Status -->
        <GroupBox Grid.Row="0" Header="Server Status" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtStatus" Text="● Stopped" Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtPort" Text="Port: —"/>
            </StackPanel>
        </GroupBox>

        <!-- Client Count -->
        <GroupBox Grid.Row="1" Header="Clients" Margin="0,0,0,6">
            <TextBlock x:Name="TxtClients" Text="Connected: 0"/>
        </GroupBox>

        <!-- Pairing Code -->
        <GroupBox Grid.Row="2" Header="Pairing Code" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtPairingCode" Text="—" FontFamily="Consolas" FontSize="14" Margin="0,0,8,0"/>
                <Button x:Name="BtnGenerateCode" Content="Generate" Click="OnGenerateCode" Width="80"/>
            </StackPanel>
        </GroupBox>

        <!-- Start / Stop -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="BtnStart" Content="Start Server" Click="OnStart" Width="120" Margin="0,0,8,0"/>
            <Button x:Name="BtnStop" Content="Stop Server" Click="OnStop" Width="120"/>
        </StackPanel>

        <!-- Diagnostics Log -->
        <GroupBox Grid.Row="4" Header="Diagnostics">
            <TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
        </GroupBox>
    </Grid>
</Window>